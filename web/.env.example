# Copy to .env.local.
# Server the built app calls (Render/Railway URL). Leave empty in dev: Vite proxies to DEV_SERVER_URL.
VITE_API_URL=

# Dev only: where `npm run dev` proxies API calls. Match the server's PORT (or SERVER_HOST_PORT under Docker).
# For a dashboard that's never empty, start the server with DEMO_DATA=1 (in server/.env).
DEV_SERVER_URL=http://localhost:8080

# The wearer's first name, shown throughout the app.
VITE_WEARER_NAME=Rose
