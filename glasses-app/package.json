{
  "name": "rewind-glasses-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "mock": "tsx dev/mock-server.ts",
    "fake-phone": "tsx dev/fake-phone.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.dev.json",
    "build": "npm run typecheck && vite build",
