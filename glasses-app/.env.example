# Copy to `.env.local`. Nothing here is a secret: VITE_* values end up in the
# public app bundle, and real API keys live on the server only.

# Absolute server URL for packaged builds (e.g. wss://rewind.onrender.com/ws).
# Leave empty in dev: the app then uses same-origin /ws, which Vite proxies to
# WS_TARGET below. Whitelist this origin in app.json before packing.
VITE_SERVER_URL=
VITE_APP_TOKEN=dev
VITE_SESSION=demo-1

# Dev only: the origin Vite forwards /ws to. The local mock by default; switch
# to C's server origin (e.g. wss://rewind.onrender.com) when it is up.
WS_TARGET=ws://localhost:8787
