# Read by docker-compose.yml (copy to .env next to it). Never commit .env.
# Server settings (API keys, DEMO_DATA for the always-on demo day, ...) go in server/.env, not here.
# Shared secret between the server and the tone service. Pick any random string.
TONE_SECRET=change-me-tone

# Host ports, if 8080/8000/3000 are already taken on your machine
SERVER_HOST_PORT=8080
TONE_HOST_PORT=8000
WEB_HOST_PORT=3000

# Family app: the wearer's first name. Baked in when the web image is built, so rebuild after changing it.
VITE_WEARER_NAME=Rose

# Tone service settings
TONE_MODEL=emotion2vec/emotion2vec_plus_base
TONE_HUB=hf
# 1 = fake scores, no model download (wiring tests only; never demo this)
TONE_MOCK=0
