# Copy to .env locally; set these as environment variables on Render/Railway.
PORT=8080

# Shared with A (phone app). Keeps random clients off /ws; not a real secret.
APP_TOKEN=change-me-app

# Shared with D (Creao). Bearer secret for /facts, /qa/today, /log/today, /settings, /creao/summary and /debug/match.
FACTS_SECRET=change-me-facts

# Rides in the Creao webhook URL (/creao/webhook?s=...). Separate from FACTS_SECRET.
WEBHOOK_SECRET=change-me-webhook

# Public HTTPS URL of this server, used for Creao webhook_url.
PUBLIC_URL=http://localhost:8080

# Wearer's time zone, used to format "at" on the glasses.
TIMEZONE=America/Los_Angeles

# Speech provider: fake (offline default) | elevenlabs (selected live provider) | deepgram (fallback)
SPEECH_PROVIDER=fake
SPEECH_API_KEY=

# Optional provider-specific aliases; a nonempty SPEECH_API_KEY takes precedence.
ELEVENLABS_API_KEY=
DEEPGRAM_API_KEY=
# Calibrate with real G2 recordings. Blank threshold means all unlabeled speech is unknown.
SPEECH_WEARER_THRESHOLD_DB=
# Abstain within this distance on either side of the threshold (dB).
SPEECH_WEARER_MARGIN_DB=3
SPEECH_SILENCE_THRESHOLD_DB=-50
# Deepgram connection-local setup; recalibrate labels after reconnect/resume.
SPEECH_WEARER_SPEAKER=
SPEECH_SPEAKER_NAMES={}
# Who is the wearer: glasses (the phone's speakerRole tags, loudness only where it sends none) | loudness
SPEECH_ROLE_SOURCE=glasses


# Matching. Without GEMINI_API_KEY the server falls back to a local
# word-overlap matcher so everything still runs offline (worse accuracy).
GEMINI_API_KEY=
EMBED_MODEL=gemini-embedding-001
VERIFY_MODEL=gemini-2.5-flash

# Yes/no checks: gemini (default) or stepfun. Embeddings always use Gemini; StepFun has no embeddings API.
# Compare first: VERIFY_PROVIDER=stepfun npm run test:matcher vs the default run.
# claude: yes/no checks on Claude. Without GEMINI_API_KEY, ANTHROPIC_API_KEY alone runs the whole matcher on Claude.
VERIFY_PROVIDER=gemini
STEPFUN_API_KEY=
STEPFUN_BASE_URL=https://api.stepfun.ai/v1
# A fast non-reasoning chat model; a reasoning model may return empty answers, which count as no.
STEPFUN_MODEL=
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
MATCH_THRESHOLD=0.80

# Store file
DATA_FILE=./data/store.json

# Tone of voice (tone-service/, emotion2vec+). Empty TONE_URL = tone analysis off.
# With docker compose, both are set by docker-compose.yml (TONE_SECRET comes from the root .env).
TONE_URL=http://localhost:8000
TONE_SECRET=change-me-tone

# CREAO trigger keys, one per saved agent (agent.creao.ai > Settings > API keys). Server side only, never in the repo.
# Without a key that agent's run fails with a clear message and nothing else is affected.
CAPI_KEY_DAILY_BRIEF=
CAPI_KEY_PATTERN_FINDER=
CAPI_KEY_OPEN_QUESTIONS=
CAPI_KEY_CARE_ASSISTANT=

# Creao runs started by the server, wearer's local time (HH:MM). Each fires within 15 minutes after its time,
# and that window doesn't cross midnight, so keep both at 23:45 or earlier.
SUMMARY_AT=20:00
PATTERNS_AT=23:30

# 1 = a demo day (src/demo.ts) on the glasses and the dashboard, with real data added on top. POST /demo/reset refreshes it.
# Off again: the next start removes the demo day from the store (and the Docker volume).
DEMO_DATA=0

# production turns off /debug/* (the Dockerfile sets it)
# NODE_ENV=production
